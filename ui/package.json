{
  "name": "camellia-nexus-ui",
  "private": true,
  "packageManager": "pnpm@11.28.7",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "predev": "node ../scripts/prepare-privilege-broker.mjs",
    "dev": "vite --host 127.0.0.1 --port 1420",
    "prebuild": "node ../scripts/prepare-privilege-broker.mjs",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --experimental-strip-types scripts/test-ui.mjs && node scripts/test-native-driver.mjs",
    "test:e2e": "playwright test",
    "test:e2e:stability": "playwright test --workers=1 --repeat-each=2 --grep 'reorganizes without horizontal overflow'",
    "test:native": "wdio run wdio.native.conf.mjs",
    "desktop:dev": "cd .. && node ui/node_modules/@tauri-apps/cli/tauri.js dev",
    "desktop:build": "cd .. && node ui/node_modules/@tauri-apps/cli/tauri.js build --config src-tauri/tauri.privilege-broker.conf.json",
    "desktop:build:e2e": "cd .. && node ui/node_modules/@tauri-apps/cli/tauri.js build --debug --no-bundle --features desktop-e2e --config src-tauri/tauri.e2e.conf.json"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "@tauri-apps/plugin-fs": "2.7.1",
    "ajv": "8.20.0",
    "codemirror": "6.0.2",
    "jsonc-parser": "3.3.1",
    "svelte": "5.57.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "24.19.2",
    "@wdio/cli": "10.0.2",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/native-utils": "2.8.0",
    "@wdio/spec-reporter": "9.32.0",
    "@wdio/tauri-plugin": "1.5.0",
    "@wdio/tauri-service": "1.5.0",
    "@wdio/types": "9.32.0",
    "expect-webdriverio": "6.1.0",
    "mocha": "11.8.0",
    "serialize-javascript": "7.1.3",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "webdriverio": "9.32.0"
  }
}
